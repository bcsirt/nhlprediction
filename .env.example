# Application
APP_NAME="NHL Prediction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=nhl_prediction
DB_USERNAME=sail
DB_PASSWORD=password

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_STORE=redis
CACHE_PREFIX=nhl_pred

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nhl-prediction.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# NHL API
NHL_API_URL=https://api-web.nhle.com/v1
NHL_STATS_API_URL=https://api.nhle.com/stats/rest
NHL_API_TIMEOUT=30

# Python ML Service
PYTHON_ML_SERVICE_URL=http://ml-service:8000
PYTHON_ML_TIMEOUT=30

# Prediction Settings
PREDICTION_CACHE_TTL=300
PREDICTION_CONFIDENCE_THRESHOLD=0.6

# Machine Learning
ML_EPOCHS=100
ML_BATCH_SIZE=32
ML_LEARNING_RATE=0.001

# Betting/Odds API (optional - configure when needed)
ODDS_API_KEY=
ODDS_API_URL=https://api.the-odds-api.com/v4

# Feature Flags
ENABLE_LIVE_PREDICTIONS=true
ENABLE_VALUE_BETS=true
ENABLE_BACKTESTING=true
